# Normalise text to LF in the repository and in working trees on every OS.
* text=auto eol=lf

# Explicit LF for project text formats.
*.py   text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.lua  text eol=lf
*.tex  text eol=lf
*.bib  text eol=lf
*.svg  text eol=lf
*.txt  text eol=lf

# CRLF only where Windows requires or expects it.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never normalise.
*.pdf  binary
*.docx binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
